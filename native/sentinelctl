#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
[[ "$SCRIPT_PATH" == /* ]] || {
  echo "Sentinel lifecycle command requires its absolute physical release path" >&2
  exit 1
}
SCRIPT_DIRECTORY="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
PHYSICAL_SCRIPT="$SCRIPT_DIRECTORY/$(basename "$SCRIPT_PATH")"
[[ "$SCRIPT_PATH" == "$PHYSICAL_SCRIPT" && ! -L "$SCRIPT_PATH" ]] || {
  echo "Sentinel lifecycle command must run through its physical release path" >&2
  exit 1
}

usage() {
  echo "Usage: sentinelctl {bootstrap [--confirm-config]|start|status|stop}" >&2
  exit 2
}

(( $# > 0 )) || usage
ACTION="$1"
shift

case "$ACTION" in
  bootstrap|start|status|stop) ;;
  *) usage ;;
esac

ACTION_SCRIPT="$SCRIPT_DIRECTORY/.${ACTION}-action.sh"
[[ -f "$ACTION_SCRIPT" && ! -L "$ACTION_SCRIPT" ]] || {
  echo "Sentinel lifecycle action is missing: $ACTION" >&2
  exit 1
}

export SENTINEL_LIFECYCLE_DISPATCH="$ACTION"
# Internal action modules are data in the immutable release and are sourced
# only through this public command. They deliberately are not executable.
# shellcheck source=/dev/null
source "$ACTION_SCRIPT"
