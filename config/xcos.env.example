# Reference for the environment file created at
# /etc/isarmg/xcos.env by the installed 0.4.3
# bootstrap script. Do not copy this template into the source tree.
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=sqlite:///var/lib/isarmg/xcos/db/app.db

# At least 32 random characters.
APP_JWT_SECRET=replace-with-at-least-32-random-characters

# Exactly 32 random bytes, encoded as base64.
CREDENTIALS_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-admin-password
APP_ENV=production
MEDIA_TOKEN_TTL_SECS=120

MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
MEDIAMTX_CONFIG=/opt/isarmg/xcos/releases/0.4.3/config/mediamtx.yml
MEDIAMTX_CONTRACT=/opt/isarmg/xcos/releases/0.4.3/config/mediamtx.lock
MEDIAMTX_BINARY=/opt/isarmg/xcos/releases/0.4.3/bin/mediamtx
RECORDINGS_DIR=/var/lib/isarmg/xcos/recordings
XCOS_RUNTIME_DIR=/run/isarmg/xcos
PUBLIC_WEBRTC_BASE_URL=/media-webrtc
PUBLIC_HLS_BASE_URL=/media-hls
# Public MediaMTX RTSPS listener reached by paired xcocs. The
# certificate must chain to a CA trusted by FFmpeg on every Client and match
# this DNS name.
PUBLIC_RTSP_PUBLISH_BASE_URL=rtsps://xcos.example.com:8322
MEDIAMTX_RTSP_CERT=/etc/isarmg/xcos-rtsp.crt
MEDIAMTX_RTSP_KEY=/etc/isarmg/xcos-rtsp.key

# IP or DNS name browsers use to reach this machine. For LAN access, replace
# 127.0.0.1 with the server's LAN IP. Multiple values are comma-separated.
MEDIA_PUBLIC_HOSTS=127.0.0.1


# Retention and runtime tuning.
RECORD_DELETE_AFTER=168h
STATUS_INTERVAL_SECS=10
RECONCILE_INTERVAL_SECS=60
REQUEST_TIMEOUT_SECS=20
RUST_LOG=info,tower_http=info
