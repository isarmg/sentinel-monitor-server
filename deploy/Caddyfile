{$SITE_ADDRESS::80} {
    encode zstd gzip

    # Run this gateway locally or on the central router. All three upstreams
    # belong to one Xcos host; defaults retain the local deployment. MediaMTX
    # API, playback API and metrics stay on that host's loopback interfaces.
    handle_path /media-webrtc/* {
        reverse_proxy {$XCOS_WEBRTC_UPSTREAM:127.0.0.1:8889}
    }

    handle_path /media-hls/* {
        reverse_proxy {$XCOS_HLS_UPSTREAM:127.0.0.1:8888} {
            header_down Location "^/(.*)$" "/media-hls/$1"
        }
    }

    # Xcos serves both the administrator API and the immutable Web build.
    handle {
        reverse_proxy {$XCOS_HTTP_UPSTREAM:127.0.0.1:8080}
    }
}
